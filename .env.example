NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- Database ----
DATABASE_URL=postgresql://portaria:portaria@localhost:5433/portaria_dev
DATABASE_POOL_SIZE=10

# ---- Redis (BullMQ, slots de envio, cota diária, travas e cache de JID) ----
REDIS_URL=redis://localhost:6379

# ---- Worker de disparo ----
# false = esta instância só atende HTTP e não consome a fila (use ao rodar
# várias réplicas da API com um worker dedicado).
WORKER_ENABLED=true
# Quantos condomínios podem estar enviando ao mesmo tempo. Por condomínio o
# envio continua serializado por uma trava no Redis.
NOTIFICATION_CONCURRENCY=15

# ---- Auth ----
JWT_SECRET=change-me-in-prod-please
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---- Webhook ----
# URL pública da API — é o que a aplicação registra no gateway WhatsApp.
# Ex.: https://api.seudominio.com
WEBHOOK_BASE_URL=

# ---- OpenWA (gateway WhatsApp multi-sessão — 1 instância por condomínio) ----
# Vazio = integração desligada (o app roda normalmente sem o gateway).
OPENWA_BASE_URL=https://openwa.bellory.com.br
OPENWA_API_KEY=owa_k1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Prefixo do nome da sessão (evita colisão entre ambientes que compartilham o mesmo gateway)
OPENWA_SESSION_PREFIX=chegou
# Base pública p/ o gateway alcançar nosso webhook (em dev, use um túnel). Vazio = não registra webhook.
OPENWA_WEBHOOK_BASE_URL=
# Timeout de cada chamada ao gateway (ms). Impede que uma sessão travada segure o worker.
OPENWA_TIMEOUT_MS=15000

# ---- OCR de etiquetas (serviço interno, ver ocr/README.md) ----
# Vazio = leitura de etiqueta desligada (a API sobe normalmente, só a rota de
# ler etiqueta responde 503).
#
# Este .env vale para a API rodando FORA do Docker (`npm run start:dev`), então
# o endereço é o localhost com a porta publicada pelo compose de dev.
# Se a API roda DENTRO do compose, quem manda é o docker-compose.yml, que já
# usa `http://ocr:8000` (nome do serviço na rede interna) — não é este arquivo.
OCR_BASE_URL=http://localhost:8000
OCR_TIMEOUT_MS=30000

# ---- Storage de fotos (S3-compatível, MinIO em dev) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=portaria-fotos
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=portaria
STORAGE_SECRET_KEY=portaria123
STORAGE_PUBLIC_URL=http://localhost:9000/portaria-fotos
