# =============================================================================
# Chegou — produção (single-server). Copie para deploy/.env e preencha.
#   cp .env.example .env && nano .env
# NUNCA commite o .env (já está no .gitignore).
# =============================================================================

# ---- Domínio / rede ----------------------------------------------------------
DOMAIN=chegou.bellory.com.br
# Porta LOCAL (só 127.0.0.1) onde a stack escuta. O reverse proxy do host encaminha
# chegou.bellory.com.br → 127.0.0.1:APP_PORT e faz o TLS. Troque se 8090 já estiver em uso.
APP_PORT=8090

# (As imagens api/web são buildadas no próprio servidor — não há registry a configurar.)
# (TLS/HTTPS é responsabilidade do reverse proxy que já existe no seu servidor — ver README.)

# ---- Banco de dados ----------------------------------------------------------
# Gere uma senha forte: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha-do-postgres

# ---- Auth --------------------------------------------------------------------
# Gere: openssl rand -hex 32   (mínimo 16 chars)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-chars
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---- Superadmin inicial (criado por: docker compose exec api node scripts/seed-prod.js)
SUPERADMIN_EMAIL=admin@bellory.com.br
SUPERADMIN_PASSWORD=troque-esta-senha-do-superadmin
SUPERADMIN_NOME=Super_Admin

# ---- OpenWA (gateway WhatsApp multi-sessão — 1 instância por condomínio) -----
# OBRIGATÓRIO para conectar/disparar via OpenWA. Vazio = integração desligada
# (a tela mostra "não configurada" e o provisionamento falha).
OPENWA_BASE_URL=https://openwa.bellory.com.br
OPENWA_API_KEY=owa_k1_62dff06d50be664de9c1831d367990ceb34bef89543fb3b4a00d6cbf086f4565
OPENWA_SESSION_PREFIX=chegou
# Opcional: base pública p/ registrar o webhook das sessões. Se vazio, usa https://DOMAIN.
OPENWA_WEBHOOK_BASE_URL=
# Timeout de cada chamada ao gateway (ms). Sessão travada não segura a fila de envio.
OPENWA_TIMEOUT_MS=15000

# ---- Disparo de notificações -------------------------------------------------
# Quantos condomínios podem enviar ao mesmo tempo (por condomínio, o envio
# continua um de cada vez). Suba junto com a capacidade do gateway.
NOTIFICATION_CONCURRENCY=15
# Deixe true na instância que processa a fila. Se um dia rodar mais de uma
# réplica da API, ponha false nas que só atendem HTTP.
WORKER_ENABLED=true

# ---- Storage de fotos (MinIO no Docker) --------------------------------------
MINIO_ROOT_USER=chegou
# Gere: openssl rand -hex 20
MINIO_ROOT_PASSWORD=troque-esta-senha-do-minio
STORAGE_BUCKET=portaria-fotos
